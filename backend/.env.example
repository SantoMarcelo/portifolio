# Ambiente: development | test | production (em production os endpoints /api/test/* ficam desativados)
NODE_ENV=development
PORT=3333

# SQLite (caminho relativo à pasta prisma/)
DATABASE_URL="file:./dev.db"

# JWT
JWT_SECRET=troque-este-segredo-em-producao
JWT_EXPIRES_IN=24h

# Latência artificial (ms) aplicada a todas as rotas /api/v1 (0 = desligada)
SIMULATE_LATENCY_MS=0

# Origem permitida pelo CORS (frontend)
CORS_ORIGIN=http://localhost:5173
