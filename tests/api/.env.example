# Loja QA backend (see ../README.md). The API is served under API_BASE_PATH.
BASE_URL=http://localhost:3333
API_BASE_PATH=/api/v1

# Seed users: login happens through POST /auth/login (no UI, no OAuth/2FA)
DEFAULT_USER_ID=2
DEFAULT_USER_USERNAME=cliente@loja.com
DEFAULT_USER_PASSWORD=Cliente@123
ADMIN_USER_ID=1
ADMIN_USER_USERNAME=admin@loja.com
ADMIN_USER_PASSWORD=Admin@123

# Optional mTLS (leave empty when not needed)
TLS_KEY_PATH=
TLS_CERT_PATH=
TLS_CA_PATH=

SAVE_TEST_OUTPUT=false
